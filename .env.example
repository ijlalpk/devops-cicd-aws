# Copy this file to .env on the SERVER and fill real values.
# .env is in .gitignore - it must never reach GitHub. 

APP_VERSION=1.0.0
AWS_REGION=eu-north-1
SECRET_KEY=change-this-to-a-long-random-string

# Amazon RDS (paste the endpoint from the RDS console, no port at the end)
DB_HOST=devops-db.abcdefg12345.eu-north-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your-strong-database-password
DB_NAME=appdb

# Amazon S3 (bucket names are globally unique - add digits to yours)
S3_BUCKET=devops-cicd-noor-2026 
